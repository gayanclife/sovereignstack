# =============================================================================
# SovereignStack — example configuration
# =============================================================================
#
# Copy to ~/.sovereignstack/sovstack.yaml or pass with --config /path/to/file.
#
# Precedence (highest wins): CLI flags > environment variables > this file > defaults.
#
# Every field also accepts an environment variable override; see the env tag
# next to each field in core/config/config.go for the exact name. Common ones
# are listed inline below.

# -----------------------------------------------------------------------------
# Logging — applies to every service (gateway, policy, discovery,
# metrics-proxy, visibility).
# -----------------------------------------------------------------------------
log:
  format: text   # text (dev-friendly) | json (production / log shippers)
  level: info    # debug | info | warn | error
  # env: SOVSTACK_LOG_FORMAT, SOVSTACK_LOG_LEVEL

# -----------------------------------------------------------------------------
# Gateway — the request hot path (auth, access, quota, routing, /metrics).
# -----------------------------------------------------------------------------
gateway:
  port: 8001
  rate_limit: 100             # requests per minute per user (0 = unlimited)
  api_key_header: X-API-Key
  backend: http://localhost:8000   # fallback backend when no model router match
  discovery_url: http://localhost:8889   # where the gateway polls /api/v1/models/running
  keys_file: ~/.sovereignstack/keys.json
  audit_db: ./sovstack-audit.db
  # env: SOVSTACK_GATEWAY_PORT, SOVSTACK_GATEWAY_RATE_LIMIT, SOVSTACK_KEYS_FILE, ...

  # ---------------------------------------------------------------------------
  # Admission control — host-aware adaptive circuit breaker.
  #
  # Polls each running model's vLLM /metrics via the metrics-proxy service,
  # tracks an EMA of GPU kv-cache pressure, and rejects with 503 +
  # Retry-After when the host approaches saturation. The dynamic hard cap
  # tightens by `stress_margin` when EMA crosses 0.9 * cap and steps back
  # up by half on each `calm_seconds` window of EMA below `soft_cache_pct`.
  #
  # Per-model queue cap = max_queue_per_gb * (host VRAM in GB / running models).
  # Disable with `enabled: false` to fully bypass (preserves prior behavior).
  # ---------------------------------------------------------------------------
  admission:
    enabled: true            # master switch
    hard_cache_pct: 95       # upper bound on dynamic cap (reject above this)
    soft_cache_pct: 80       # warn-only threshold
    min_hard_cache_pct: 60   # floor for the dynamic cap under sustained stress
    stress_margin: 10        # how far the cap drops on a stress event
    max_queue_per_gb: 4      # queued-request cap per GB of host VRAM
    poll_seconds: 5          # how often per-model metrics are scraped
    ema_alpha: 0.2           # smoothing factor in (0,1]; higher = more responsive
    calm_seconds: 300        # EMA must stay below soft for this long to relax cap
    # env: SOVSTACK_ADMISSION_ENABLED, SOVSTACK_ADMISSION_HARD_CACHE_PCT, ...

# -----------------------------------------------------------------------------
# Policy — user / quota / access REST API. Owns ~/.sovereignstack/keys.json.
# Admin Bearer required for mutations. Optional OIDC sign-in for human admins.
#
# This service is :8888 by default; the other two control-plane services
# (`discovery` :8889, `metrics-proxy` :8890) take their port from CLI flags
# and have no YAML block of their own — they're stateless and don't need one.
# -----------------------------------------------------------------------------
policy:
  port: 8888
  keys_file: ~/.sovereignstack/keys.json
  admin_key: ""               # leave blank; set via SOVSTACK_ADMIN_KEY env in production
  # env: SOVSTACK_POLICY_PORT, SOVSTACK_ADMIN_KEY

# -----------------------------------------------------------------------------
# Visibility — analytics backend (commercial). Reads from gateway + the
# three management-side services (policy / discovery / metrics-proxy).
# -----------------------------------------------------------------------------
visibility:
  port: 9000
  gateway_url: http://localhost:8001
  keys_file: ~/.sovereignstack/keys.json
  db_type: sqlite             # sqlite (dev) | mysql (production)
  db:
    host: localhost
    port: 3306
    name: visibility
    user: visibility
    password: ""              # set via SOVSTACK_DB_PASSWORD env
  # env: SOVSTACK_VISIBILITY_PORT, SOVSTACK_DB_HOST, SOVSTACK_DB_PASSWORD, ...

# -----------------------------------------------------------------------------
# CORS — applies to any service that exposes browser-callable endpoints.
# -----------------------------------------------------------------------------
cors:
  origins:
    - http://localhost:3000   # web dashboard
  allow_dev_wildcard: false   # set true ONLY in dev to allow "*" — never in production
